      function openNewMeeting(dateStr) {
            if (!dateStr) return;
            var selected = new Date(dateStr);
            selected.setHours(0, 0, 0, 0);
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            if (selected < today) {
                  showPastDateAlert();
                  return;
            }

            var now = new Date();
            var hours = String(now.getHours()).padStart(2, '0');
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var dt = dateStr + 'T' + hours + ':' + minutes;

            var end = new Date(now);
            end.setHours(end.getHours() + 1);
            var endHours = String(end.getHours()).padStart(2, '0');
            var endMinutes = String(end.getMinutes()).padStart(2, '0');
            var dtEnd = dateStr + 'T' + endHours + ':' + endMinutes;

            $('#mtgStart').val(dt);
            $('#mtgEnd').val(dtEnd);
            $('#mtgError').addClass('d-none');
            $('#mtgSuccess').addClass('d-none');
            $('#newMeetingModal').modal('show');
      }

      function isMeetingLocked(startUtcIso) {
            if (!startUtcIso) return false;
            var startTime = new Date(startUtcIso).getTime();
            var now = new Date().getTime();
            var fifteenMinMs = 15 * 60 * 1000;
            return now >= (startTime - fifteenMinMs);
      }

      function isMeetingPast(startUtcIso) {
            if (!startUtcIso) return false;
            var startDate = new Date(startUtcIso);
            var today = new Date();
            startDate.setHours(0, 0, 0, 0);
            today.setHours(0, 0, 0, 0);
            return startDate < today;
      }

