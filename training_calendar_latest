@model Mdarpan.Models.BAL.CalendarMonthViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = string.Format("Training Calendar - {0:MMMM yyyy}", new DateTime(Model.Year, Model.Month, 1));
    ViewBag.ActiveTab = "Calendar";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var prevMonth = Model.Month > 1 ? Model.Month - 1 : 12;
    var prevYear = Model.Month > 1 ? Model.Year : Model.Year - 1;
    var nextMonth = Model.Month < 12 ? Model.Month + 1 : 1;
    var nextYear = Model.Month < 12 ? Model.Year : Model.Year + 1;
    string[] dayNames = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
    // Use TodayDate from model (set using IST timezone in controller)
    var todayMonth = Model.TodayDate.Month;
    var todayYear = Model.TodayDate.Year;
}

<link href="~/Content/TrainingCalendar/site.css" rel="stylesheet" />

<style>
    :root {
        --navy-thead: #0f223d;
        --brand-red: #c0392b;
        --brand-red-dark: #962d22;
        --border-color: #e2e8f0;
    }

    .calendar-page-wrapper {
        padding: 10px 16px 24px;
    }

    .page-header-box {
        margin-bottom: 0.75rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid #e9ecef;
    }

    .page-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
    }

    .page-breadcrumb {
        font-size: 0.76rem;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .calendar-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .calendar-header-bar {
        background: linear-gradient(90deg, var(--brand-red) 0%, var(--brand-red-dark) 100%);
        color: #ffffff;
        padding: 8px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

        .calendar-header-bar h2 {
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -0.2px;
            color: #ffffff;
        }

    .calendar-nav-btn {
        background: rgba(255, 255, 255, 0.18);
        color: #ffffff !important;
        width: 28px;
        height: 28px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none !important;
        font-size: 0.75rem;
        transition: background 0.15s ease;
    }

        .calendar-nav-btn:hover {
            background: rgba(255, 255, 255, 0.32);
        }

    .calendar-nav-today {
        background: #ffffff;
        color: var(--brand-red) !important;
        font-weight: 700;
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 4px;
        text-decoration: none !important;
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

        .calendar-nav-today:hover {
            background: #f8fafc;
        }

    .cal-top-meta-bar {
        background: #f8fafc;
        border-bottom: 1px solid var(--border-color);
        padding: 6px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cal-legend-group {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .legend-item {
        font-size: 0.75rem;
        font-weight: 600;
        color: #475569;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }

        .legend-dot.blue {
            background-color: #0284c7;
        }

        .legend-dot.yellow {
            background-color: #f59e0b;
        }

        .legend-dot.green {
            background-color: #10b981;
        }

    .meeting-count-badge {
        background: #e2e8f0;
        color: #1e293b;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .cal-day-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background-color: var(--navy-thead);
        color: #ffffff;
        text-align: center;
        font-size: 0.74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .cal-day-header span {
            padding: 6px 2px;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }

            .cal-day-header span:last-child {
                border-right: none;
            }

    .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background-color: var(--border-color);
        gap: 1px;
    }

    .cal-cell {
        background: #ffffff;
        min-height: 74px; /* Compact height */
        max-height: 88px;
        padding: 4px 6px;
        display: flex;
        flex-direction: column;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        transition: background-color 0.15s ease;
    }

        .cal-cell:hover {
            background-color: #f8fafc;
        }

        .cal-cell.other-month {
            background: #fafbfc;
            opacity: 0.5;
        }

        .cal-cell.today {
            background: #fffdf5;
            box-shadow: inset 0 0 0 2px #f59e0b;
        }

            .cal-cell.today .cal-date {
                background-color: #f59e0b;
                color: #ffffff;
                border-radius: 50%;
                width: 19px;
                height: 19px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .cal-cell.past-day {
            background-color: #fbfbfb;
        }

    .cal-date {
        font-size: 0.78rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 2px;
        align-self: flex-start;
        line-height: 1.1;
    }

    .cal-session {
        font-size: 0.68rem;
        font-weight: 600;
        padding: 1px 5px;
        border-radius: 3px;
        margin-bottom: 2px;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    }

        .cal-session.type-team {
            background-color: #e0f2fe;
            color: #0369a1;
            border-left: 2px solid #0284c7;
        }

        .cal-session.type-focus {
            background-color: #fef3c7;
            color: #92400e;
            border-left: 2px solid #f59e0b;
        }

        .cal-session.type-standup {
            background-color: #d1fae5;
            color: #065f46;
            border-left: 2px solid #10b981;
        }

        .cal-session.type-default {
            background-color: #f1f5f9;
            color: #475569;
            border-left: 2px solid #64748b;
        }

    .cal-more {
        font-size: 0.68rem;
        font-weight: 700;
        color: #64748b;
        cursor: pointer;
        line-height: 1.1;
        margin-top: 1px;
    }

        .cal-more:hover {
            color: var(--brand-red);
            text-decoration: underline;
        }

    .disable-fields {
        cursor: not-allowed;
        background-color: #f1f5f9 !important;
    }

    #newMeetingForm .form-control,
    input[type="text"],
    input[type="datetime-local"],
    textarea {
        color: #212529 !important;
        opacity: 1 !important;
    }

    .mini-toast {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: #1e293b;
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 6px;
        font-size: 12px;
        z-index: 99999;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

    .btn-submit-meeting {
        background-color: var(--brand-red) !important;
        color: #ffffff !important;
        font-weight: 600;
    }

        .btn-submit-meeting:hover {
            background-color: var(--brand-red-dark) !important;
        }
</style>

<div class="calendar-page-wrapper">
    <div class="page-header-box d-flex justify-content-between align-items-center">
        <div>
            <div class="page-breadcrumb">Training Calendar &nbsp;/&nbsp; Monthly View</div>
        </div>
        <div class="text-muted small font-weight-bold">
            @monthName
        </div>
    </div>

    <div class="calendar-card">
        <div class="calendar-header-bar">
            <h2>@monthName</h2>
            <div class="d-flex align-items-center" style="gap:6px;">
                <a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = prevMonth, year = prevYear })" class="calendar-nav-btn" title="Previous Month">
                    <i class="fas fa-chevron-left"></i>
                </a>
                <a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = todayMonth, year = todayYear })" class="calendar-nav-today">
                    Today
                </a>
                <a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = nextMonth, year = nextYear })" class="calendar-nav-btn" title="Next Month">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>

        <div class="cal-top-meta-bar">
            <div class="cal-legend-group">
                <span class="legend-item"><span class="legend-dot blue"></span>Team</span>
                <span class="legend-item"><span class="legend-dot yellow"></span>Focus</span>
                <span class="legend-item"><span class="legend-dot green"></span>Stand-up</span>
            </div>
            <span class="meeting-count-badge">
                <i class="fas fa-video text-muted mr-1"></i> @Model.Sessions.Count meetings
            </span>
        </div>

        <div class="cal-day-header">
            @foreach (var d in dayNames)
            {
                <span>@d</span>
            }
        </div>

        <div class="cal-grid">
            @foreach (var day in Model.Days)
            {
                var hasSession = day.Sessions.Count > 0;
                var isPast = day.FullDate.Date < Model.TodayDate.Date;
                var cellClass = "cal-cell";
                if (!day.IsCurrentMonth) { cellClass += " other-month"; }
                if (day.FullDate.Date == Model.TodayDate.Date) { cellClass += " today"; }
                if (hasSession) { cellClass += " has-sessions"; }
                if (isPast) { cellClass += " past-day"; }

                <div class="@cellClass" data-date="@day.FullDate.ToString("yyyy-MM-dd")" @if (Session["Role"] as string == "Admin") { if (isPast) { <text> onclick="showPastDateAlert()" </text>  } else { <text> onclick="openNewMeeting('@day.FullDate.ToString("yyyy-MM-dd")')" </text> } }>
                    <div class="cal-date">@day.Day</div>
                    @foreach (var s in day.Sessions.Take(2))
                    {
                        var badge = "type-default";
                        var title = s.Title ?? "";
                        if (title.IndexOf("Stand", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-standup"; }
                        else if (title.IndexOf("Focus", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-focus"; }
                        else if (title.IndexOf("Team", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-team"; }

                        <span class="cal-session @badge" title="@s.Title&#10;@s.StartLocal - @s.EndLocal"
                                                                        onclick="event.stopPropagation(); showSessionDetail(@s.SessionId);">
                            @s.Title
                        </span>
                    }
                    @if (day.Sessions.Count > 2)
                    {
                        var daySessJson = Newtonsoft.Json.JsonConvert.SerializeObject(
                        day.Sessions.Select(s => new { s.SessionId, s.Title, Start = s.StartLocal ?? "", End = s.EndLocal ?? "" }));
                        <span class="cal-more" onclick="event.stopPropagation(); showDaySessions(this)"
                                                                        data-date="@day.FullDate.ToString("yyyy-MM-dd")"
                                                                        data-sessions='@Html.Raw(daySessJson)'>+@(day.Sessions.Count - 2) more</span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div id="pastDateToast" style="display:none; position:fixed; top:80px; left:50%; transform:translateX(-50%); z-index:9999; min-width:320px;">
    <div class="alert alert-warning alert-dismissible shadow" role="alert" style="border-left:4px solid #f59e0b;">
        <i class="fas fa-exclamation-triangle mr-2"></i>
        <strong>Past Date Selected!</strong> You cannot schedule a meeting on a past date. Please select today or a future date.
        <button type="button" class="close" onclick="$(this).closest('#pastDateToast').fadeOut()">
            <span>&times;</span>
        </button>
    </div>
</div>

<div class="modal fade" id="newMeetingModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-calendar-plus mr-2"></i>Schedule New Meeting</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            @Html.Partial("_NewMeetingForm")
        </div>
    </div>
</div>

