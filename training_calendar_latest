                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <!-- Admin Editable View -->
                @if (Session["Role"] as string == "Admin")
                {
                    <form id="inlineEditForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionId" id="sdSessionId" />

                        <div id="sdLockedBanner" class="alert alert-warning d-none mb-3">
                            <i class="fas fa-lock mr-1"></i> This meeting starts within 15 minutes or has already started. Editing is locked.
                        </div>

                        <div class="form-group">
                            <label><strong>Title</strong></label>
                            <input type="text" name="Title" id="sdEditTitle" class="form-control" required minlength="5" />
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label><strong><i class="fas fa-user mr-1"></i>Organizer Email</strong></label>
                                <input type="email" name="OrganizerEmail" id="sdEditOrgEmail" class="form-control" readonly />
                            </div>
                            <div class="form-group col-md-6">
                                <label><strong><i class="fas fa-flag mr-1"></i>Status</strong></label>
                                <input type="text" id="sdEditStatus" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label><strong><i class="fas fa-calendar mr-1"></i>Start Date & Time</strong></label>
                                <input type="datetime-local" name="StartUtc" id="sdEditStart" class="form-control" required />
                            </div>
                            <div class="form-group col-md-6">
                                <label><strong><i class="fas fa-calendar-check mr-1"></i>End Date & Time</strong></label>
                                <input type="datetime-local" name="EndUtc" id="sdEditEnd" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label><strong><i class="fas fa-list-alt mr-1"></i>Agenda</strong></label>
                            <textarea name="Agenda" id="sdEditAgenda" class="form-control" rows="3" required minlength="10"></textarea>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label><strong><i class="fas fa-users mr-1"></i>Registered</strong></label>
                                <input type="text" id="sdEditCount" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="form-group">
                            <label><strong><i class="fas fa-envelope mr-1"></i>Attendee Emails</strong> <small class="text-muted">(comma separated, to add to Teams)</small></label>
                            <input type="text" name="AttendeeEmails" id="sdEditAttendees" class="form-control" placeholder="user1@company.com, user2@company.com" />
                        </div>

                        <div id="sdJoinDiv" class="mb-3 d-none">
                            <a id="sdJoinLink" href="#" target="_blank" class="btn btn-success btn-block">
                                <i class="fas fa-video mr-1"></i> Join Teams Meeting
                            </a>
                            <button type="button" class="btn btn-outline-secondary btn-block mt-2" onclick="copyMeetingLink()">
                                <i class="fas fa-copy mr-1"></i> Copy Meeting Link
                            </button>
                        </div>

                        <div id="sdEditError" class="alert alert-danger d-none"></div>
                        <div id="sdEditSuccess" class="alert alert-success d-none"></div>

                        <div class="d-flex justify-content-between mt-3">
                            <div>
                                <button type="button" class="btn btn-outline-primary btn-sm" style="display:none;" onclick="viewAttendanceReport()">
                                    <i class="fas fa-clipboard-list mr-1"></i> Attendance
                                </button>
                                <button type="button" class="btn btn-outline-success btn-sm" onclick="downloadAttendance()">
                                    <i class="fas fa-download mr-1"></i> CSV
                                </button>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-submit-meeting" id="sdEditSaveBtn">
                                    <i class="fas fa-save mr-1"></i> Save Changes
                                </button>
                                <button type="button" id="CancelBtnID" class="btn btn-outline-primary btn-sm" onclick="CancelMeeting()">
                                    Cancel Meeting
                                </button>
                            </div>
                        </div>
                    </form>
                }

                @if (Session["Role"] as string == "Dealer")
                {
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-user mr-1"></i>Organizer:</strong> <span id="sdOrganizer"></span></p>
                            <p><strong><i class="fas fa-calendar mr-1"></i>Date:</strong> <span id="sdDate"></span></p>
                        </div>
                        <div class="col-md-6">
                            <p><strong><i class="fas fa-flag mr-1"></i>Status:</strong> <span id="sdStatus" class="badge badge-info"></span></p>
                            <p><strong><i class="fas fa-users mr-1"></i>Registered:</strong> <span id="sdCount"></span> participants</p>
                        </div>
                    </div>
                    <hr />
                    <p><strong><i class="fas fa-list-alt mr-1"></i>Agenda:</strong></p>
                    <div id="sdAgenda" class="p-3 bg-light rounded mb-3" style="max-height:200px;overflow-y:auto;"></div>

                    <div id="sdJoinDivDealer" class="mb-3 d-none">
                        <a id="sdJoinLinkDealer" href="#" target="_blank" class="btn btn-success btn-block">
                            <i class="fas fa-video mr-1"></i> Join Teams Meeting
                        </a>
                        <button type="button" class="btn btn-outline-secondary btn-block mt-2" onclick="copyMeetingLinkDealer()">
                            <i class="fas fa-copy mr-1"></i> Copy Meeting Link
                        </button>
                    </div>

                    <div id="sdRegisterSection" class="d-none">
                        <hr />
                        <h6><i class="fas fa-user-plus mr-1"></i> Register for this Training</h6>
                        <form id="registerForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="regSessionId" name="sessionId" />
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Dealer Code</label>
                                    <input type="text" class="form-control disable-fields" id="regDealerCode" value="@(Session["DealerCode"])" readonly />
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Owner Email <span class="text-danger">*</span></label>
                                    <input type="email" name="primaryEmail" id="regEmail" class="form-control disable-fields" value="@(Session["DealerEmail"])" required readonly />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Manager Email</label>
                                <input type="email" name="secondaryEmail" id="regSecEmail" class="form-control disable-fields" readonly />
                            </div>
                            <div class="form-group">
                                <label>Display Name <span class="text-danger">*</span></label>
                                <input type="text" name="DisplayName" id="DisplayNameID" maxlength="20" placeholder="e.g. Ashutosh Jagdale" class="form-control" />
                                <small class="form-text text-muted">
                                    Enter the full name your guest will type when joining the Teams meeting.
                                    This is used to mark attendance after the meeting.
                                </small>
                            </div>
                            <div id="regError" class="alert alert-danger d-none"></div>
                            <div id="regSuccess" class="alert alert-success d-none"></div>
                            <button type="submit" class="btn btn-submit-meeting btn-block" id="regSubmitBtn">
                                <i class="fas fa-check mr-1"></i> Register Now
                            </button>
                        </form>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="daySessModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-calendar-day mr-2"></i>Sessions on <span id="daySessDate"></span></h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="daySessList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
      function isValidEmail(email) {
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            return emailRegex.test(email);
      }

      function allowInput(e) {
            var evt = e || window.event;
            var charCode = evt.which || evt.keyCode;

            if (charCode === 8 || charCode === 9 || charCode === 13) {
                  return true;
            }

            var char = String.fromCharCode(charCode);
            var regex = /^[A-Za-z0-9 \-\/\.,!]$/;

            if (!regex.test(char)) {
                  if (evt.preventDefault) {
                        evt.preventDefault();
                  }
                  return false;
            }
            return true;
      }

