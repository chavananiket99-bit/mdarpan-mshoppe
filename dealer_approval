@model Mdarpan.Models.BAL.DealerApprovalViewModel

@{
	ViewBag.Title = "Approval Request";
	ViewBag.ActiveTab = "Report";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/TrainingCalendar/site.css" rel="stylesheet" />
<script>
	$(document).ready(function () {
		jQuery('#ApprovalTableID').wrap('<div class="dataTables_scroll" />');
		var table = $('#ApprovalTableID').DataTable({
			//responsive: true,
			paging: true,
			"aLengthMenu": [[10, 25, 50, 100, 200, 300, 500], [10, 25, 50, 100, 200, 300, 500]],
			"iDisplayLength": 10,
			"oLanguage": { "sSearch": "" }
		});
	});
</script>

@if (TempData["RoleAuthMessage"] == null)
{
	<!-- Page Header -->
	<div class="page-header">
		<h2>Dealer Approval Request</h2>
		<a href="@Url.Action("DealerInviteApprove", "Meeting", new {Area="TrainingCalendar" })" class="btn btn-sm btn-outline-success ml-1 approve-btn">
			Approve all requests
		</a>
	</div>

	if (TempData["ApprovalDownloadSuccess"] != null)
	{
		<div class="alert alert-success alert-dismissible" style="border-radius:10px;">
			<i class="fas fa-exclamation-circle mr-1"></i> @TempData["ApprovalDownloadSuccess"]
			<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
		</div>
	}

	if (TempData["ApprovalDownloadError"] != null)
	{
		<div class="alert alert-danger alert-dismissible" style="border-radius:10px;">
			<i class="fas fa-exclamation-circle mr-1"></i> @TempData["ApprovalDownloadError"]
			<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
		</div>
	}


	if (Model == null || Model.objDealerApprovalList == null)
	{
		<div class="alert alert-info" style="border-radius:10px;">
			<i class="fas fa-info-circle mr-1"></i> No training sessions found.
		</div>
	}
	else
	{
		<div class="table-card p-2 m-2">
			<div class="table-responsive">
				<table class="table table-hover mb-0" id="ApprovalTableID">
					<thead>
						<tr>
							<th>Registration ID</th>
							<th>Dealer Name</th>
							<th>Dealer Code</th>
							<th>Created On</th>
							<th>Email ID</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var session in Model.objDealerApprovalList)
						{
							<tr>
								<td>@session.RegistrtaionID </td>
								<td>@session.DealerName</td>
								<td>@session.DealerCode</td>
								<td>@session.CreatedOn</td>
								<td>@session.EmailID</td>

							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}

}
else
{
	<div class="alert alert-info" style="border-radius:10px;">
		<i class="fas fa-info-circle mr-1"></i>@TempData["RoleAuthMessage"]
	</div>
	
}







