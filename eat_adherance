			}

			.summary-box .metric .label {
				font-size: 12px;
				color: #555555;
				font-weight: 500;
				white-space: nowrap;
			}

			.summary-box .metric .value {
				font-size: 13px;
				font-weight: 700;
				color: #1a1a1a;
				background: #f0f2f5;
				border-radius: 4px;
				padding: 1px 8px;
				min-width: 28px;
				text-align: center;
			}

	input[type="radio"] + label {
