		.summary-box .metric {
			padding: 4px 8px;
		}

		.summary-box .summary-title {
			border-right: none;
			padding-right: 0;
		}
	}


	.custom_table table thead tr th {
		padding: 4px 8px !important;
	}

	.custom_table table thead tr th {
		border: 1px solid !important;
	}

	.custom_table table thead tr th {
		vertical-align: middle;
	}

	.excel-main {
		z-index: 1;
		cursor: pointer;
		right: 20%;
		position: absolute;
	}

	.radio-main {
		z-index: 1;
		left: 18%;
		position: absolute;
		top: 1%;
	}

	.top-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 10px;
	}

	.top-bar-left {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
	}

	.top-bar-right {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	/* Summary box — horizontal layout (single row) */
	.summary-box {
		display: flex;
		align-items: center;
		gap: 4px;
		background: #ffffff;
		border: 1px solid #dde1e7;
		border-left: 4px solid #c0392b;
		border-radius: 6px;
		padding: 8px 14px;
		box-shadow: 0 2px 6px rgba(0,0,0,0.07);
		flex-wrap: wrap;
	}

		.summary-box .summary-title {
			font-size: 11px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #c0392b;
			padding-right: 12px;
			border-right: 1px solid #eaecef;
			margin-right: 8px;
			white-space: nowrap;
		}

		.summary-box .metric {
			display: flex;
			align-items: center;
			gap: 5px;
			padding: 0 10px;
			border-right: 1px solid #eaecef;
		}

