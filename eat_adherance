	}

	.td-color-etafired {
		background-color: red;
	}

	.td-color-etaavailable {
		background-color: yellow;
	}

	.eta-toggle-header-btn {
		margin-left: 6px;
		padding: 1px 7px;
		font-size: 11px;
		line-height: 16px;
		border: 1px solid #888;
		background: #fff;
		border-radius: 3px;
		cursor: pointer;
