<script src="~/Scripts/HoldOn.js"></script>
<script>

	function StartValidation() {
		HoldOn.open({
			theme: 'sk-fading-circle',
			message: "<h4>Please wait....</h4>"
		});
	}
	function StartDone() {
		setTimeout(function () {
			HoldOn.close();
		});
	}
	function ETATDColor() {
		let finalRemarkIndex = -1;

		document.querySelectorAll("#ETAAdheranceTableID thead th").forEach((th, index) => {
			if (th.innerText.trim() === "FinalRemark") {
				finalRemarkIndex = index;
			}
		});

		if (finalRemarkIndex >= 0) {

			document.querySelectorAll("#ETAAdheranceTableID tbody tr").forEach((row) => {

				let tds = row.querySelectorAll("td");
				let finalRemark = tds[finalRemarkIndex]?.innerText.trim();

				if (!finalRemark) return;

				let etaColumn = finalRemark.split(' ')[0]; // ETA2 from "ETA2 Fired"

				document.querySelectorAll("#ETAAdheranceTableID thead th").forEach((th, index) => {

					if (finalRemark.includes("Adhered")) {
						if (th.innerText.trim() === etaColumn) {

							tds[index]?.classList.add("td-color-etaadhered");
							return;
						}
					}
					else if (finalRemark.includes("Fired")) {
						if (th.innerText.trim() === etaColumn) {

							tds[index]?.classList.add("td-color-etafired");
							return;
						}
					}
					else if (finalRemark.includes("Available")) {
						if (th.innerText.trim() === etaColumn) {

							tds[index]?.classList.add("td-color-etaavailable");
							return;
						}
					}



				});

			});

		}
	}

	// Last "always visible" ETA column
	var VISIBLE_ETA_LIMIT = 4;

	function GetHeaderLabel($th) {
		var label = $th.contents().filter(function () { return this.nodeType === 3; }).text().trim();
		return label || $th.text().trim();
	}

	function GetExtraEtaColumns(dt) {
		var extra = [];
		dt.columns().every(function () {
			var idx = this.index();
			var label = GetHeaderLabel($(dt.column(idx).header()));
			var m = label.match(/^ETA(\d+)$/i);
			if (m && parseInt(m[1], 10) > VISIBLE_ETA_LIMIT) extra.push(idx);
		});
		return extra;
	}

	function InjectToggleButton(dt) {
		var $targetHeader = null;
		dt.columns().every(function () {
			var idx = this.index();
			var $h = $(dt.column(idx).header());
			if (GetHeaderLabel($h) === "ETA" + VISIBLE_ETA_LIMIT) $targetHeader = $h;
		});
		if (!$targetHeader || $targetHeader.find(".eta-toggle-header-btn").length) return;
		if (!GetExtraEtaColumns(dt).length) return;

		var $btn = $('<button type="button" class="eta-toggle-header-btn" title="Show / hide extra ETA columns">➕ More</button>');
		$btn.on("click", function (e) {
			e.stopPropagation();
			var expanded = $btn.data("expanded") === true;
			var extras = GetExtraEtaColumns(dt);
			dt.columns(extras).visible(!expanded, false);
			dt.columns.adjust().draw(false);
			$btn.data("expanded", !expanded);
			$btn.html(!expanded ? "➖ Less" : "➕ More");
		});
		$targetHeader.append($btn);
	}

	function ApplyEtaVisibility(dt) {
		var extra = GetExtraEtaColumns(dt);
		if (extra.length) {
			dt.columns(extra).visible(false, false);
			dt.columns.adjust();
		}
		InjectToggleButton(dt);
	}
	$(document).ready(function () {

		debugger;


		/*for datatable scroll properly*/
		jQuery('#ETAAdheranceTableID').wrap('<div class="dataTables_scroll" />');

		var table = $('#ETAAdheranceTableID').DataTable({
			paging: true,
			"aLengthMenu": [[10, 25, 50, 100, 200, 300, 500], [10, 25, 50, 100, 200, 300, 500]],
			"iDisplayLength": 50,
			"oLanguage": { "sSearch": "" },
			drawCallback: function () {
				ETATDColor();
			}
		});

		ApplyEtaVisibility(table);   // <-- add this line



		$("#btnExportToExcel").click(function () {
			debugger;
			// Get the DataTable instance
			var table = $("#ETAAdheranceTableID").DataTable();

			// Create a new workbook and worksheet
			var wb = XLSX.utils.book_new();
			var wsData = [];

			// Get the header text and append it to the worksheet data, skipping the first column
			var headers = [];
			$("#ETAAdheranceTableID thead th").each(function (index) {
				headers.push($(this).text().trim());
			});

			wsData.push(headers);

			// Get all data from the DataTable
			var allData = table.rows().data();

			// Function to strip HTML tags and remove title attributes from hyperlinks
			function stripHTML(html) {
				var tempDiv = document.createElement("div");
				tempDiv.innerHTML = html;
				return tempDiv.textContent || tempDiv.innerText || "";
			}

			// Process each row and append the data to worksheet data, skipping the first column
			allData.each(function (rowData) {
				var row = [];
				$.each(rowData, function (index, cellData) {

					// Strip any HTML from the cell data
					var cleanCellData = stripHTML(cellData);
					cleanCellData = cleanCellData.trim();
					//if (cleanCellData.length == 20) {
					//	row.push(cleanCellData.substr(cleanCellData.length - 10, 10));
					//}
					row.push(cleanCellData);
				});

				// Ensure row has the same number of columns as the header
				while (row.length < headers.length) {
					row.push(""); // Add empty cells if necessary to match column count
				}

				wsData.push(row);
			});

			// Convert worksheet data to a worksheet
			var ws = XLSX.utils.aoa_to_sheet(wsData);

			// Append the worksheet to the workbook
			XLSX.utils.book_append_sheet(wb, ws, "Sheet1");

			// Trigger Excel file download
			XLSX.writeFile(wb, "ETAAdherance.xlsx");
		});

		$(document).on('change', '#OrdTypeID,#SectorID', function () {
			debugger;
                        setTimeout(function () {
					        StartValidation('sk-fading-circle');
                        }, 0);
					    $.ajax({
					        type: "POST",
							url: "@Url.Action("FilterETAAdheranceData", "ETAAdherance", new { Area = "" })",
							data: { OrdType: $("#OrdTypeID").val(), Sector: $("#SectorID").val()  },
							success: function (data) {
								debugger;
								if (data.ID == 1) {
									$("#ETAAdheranceDivID").html(data.Response);
									document.getElementById("ETAAvailableID").innerHTML =data?.objcount?.ETAAvailableCount ?? 0;
									document.getElementById("ETAPendingID").innerHTML=data?.objcount?.ETAPending??0;
									document.getElementById("ETAFiredID").innerHTML=data?.objcount?.ETAFiredCount??0;
									document.getElementById("ETAAdheredID").innerHTML = data?.objcount?.ETAAdheredCount ?? 0;
									document.getElementById("ETANotAdheredID").innerHTML = data?.objcount?.ETANotAdheredCount ?? 0;
									document.getElementById("OrderExecutedID").innerHTML=data?.objcount?.OrderExecutedCount??0;
									document.getElementById("RemarkID").innerHTML=data?.objcount?.RemarkCount??0;
									StartDone();
								}
								else {
									swal(data.Message);
									StartDone();
								}

						    },
						    error: function (jqXHR, exception) {
								swal("Sorry could not process your request. Please try after some time");
								StartDone();
						    }
					    })

		});


	});


</script>

