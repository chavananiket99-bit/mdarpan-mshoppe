<style>

	.eta-summary {
		margin: 10px 0 14px;
		row-gap: 6px;
	}

	.summary-box .metric .dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
		background: #999;
	}

	/* Color coding — matches your ETA row highlights */
	.metric-available .dot {
		background: #f1c40f;
	}
	/* yellow */
	.metric-available .value {
		background: #fff8d6;
		color: #7a5c00;
	}

	.metric-pending .dot {
		background: #7f8c8d;
	}
	/* grey */
	.metric-pending .value {
		background: #eceff1;
		color: #37474f;
	}

	.metric-fired .dot {
		background: #e74c3c;
	}
	/* red */
	.metric-fired .value {
		background: #fdecea;
		color: #a5261b;
	}

	.metric-adhered .dot {
		background: #27ae60;
	}
	/* green */
	.metric-adhered .value {
		background: #e6f7ec;
		color: #1e7e42;
	}

	.metric-notadhered .dot {
		background: #c0392b;
	}

	.metric-notadhered .value {
		background: #fdecea;
		color: #a5261b;
	}

	.metric-executed .dot {
		background: #2980b9;
	}
	/* blue */
	.metric-executed .value {
		background: #e7f1fa;
		color: #1f5d8a;
	}

	.metric-remark .dot {
		background: #8e44ad;
	}
	/* purple */
	.metric-remark .value {
		background: #f2e6f7;
		color: #5e2b7a;
	}

	/* Responsive: wrap nicely on smaller widths */
