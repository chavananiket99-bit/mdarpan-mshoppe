			<i><img src="~/Images/Notifier%20Images/Errormsg.png" width="16" />&nbsp;&nbsp;</i>&nbsp;<b>Error!</b>&nbsp;&nbsp;@TempData["MshoppeErrorMessage"]
		</div>
		<br />
	}
}

