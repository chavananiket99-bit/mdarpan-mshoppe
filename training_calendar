    // Show all sessions for a day when "+N more" is clicked
    function showDaySessions(el) {
        var date = el.getAttribute('data-date');
        var sessions = JSON.parse(el.getAttribute('data-sessions'));
        var html = '<ul class="list-group">';
        for (var i = 0; i < sessions.length; i++) {
            var s = sessions[i];
            html += '<li class="list-group-item list-group-item-action" style="cursor:pointer;" ' +
                'onclick="$(\'#daySessModal\').modal(\'hide\'); showSessionDetail(' + s.SessionId + ');">' +
                '<strong>' + escapeHtml(s.Title) + '</strong>' +
                '<br><small class="text-muted">' + escapeHtml(s.Start) + (s.End ? ' \u2013 ' + escapeHtml(s.End) : '') + '</small>' +
                '</li>';
        }
        html += '</ul>';
        $('#daySessDate').text(date);
        $('#daySessList').html(html);
        $('#daySessModal').modal('show');
    }

