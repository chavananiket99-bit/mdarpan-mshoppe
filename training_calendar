    // Open new meeting modal with date pre-filled
	function openNewMeeting(dateStr) {
		debugger;

        if (!dateStr) return;
        var selected = new Date(dateStr);
        selected.setHours(0, 0, 0, 0);
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        if (selected < today) {
            showPastDateAlert();
            return;
        }


		var now = new Date();

		var hours = String(now.getHours()).padStart(2, '0');
		var minutes = String(now.getMinutes()).padStart(2, '0');

		var dt = dateStr + 'T' + hours + ':' + minutes;

		var end = new Date(now);
		end.setHours(end.getHours() + 1);

		var endHours = String(end.getHours()).padStart(2, '0');
		var endMinutes = String(end.getMinutes()).padStart(2, '0');

		var dtEnd = dateStr + 'T' + endHours + ':' + endMinutes;

        $('#mtgStart').val(dt);
		$('#mtgEnd').val(dtEnd);

        $('#mtgError').addClass('d-none');
        $('#mtgSuccess').addClass('d-none');
        $('#newMeetingModal').modal('show');
    }

    // Check if meeting is in the past or within 15 minutes of starting
    function isMeetingLocked(startUtcIso) {
        if (!startUtcIso) return false;
        var startTime = new Date(startUtcIso).getTime();
        var now = new Date().getTime();
        var fifteenMinMs = 15 * 60 * 1000;
        return now >= (startTime - fifteenMinMs);
    }

    // Check if meeting date is entirely in the past (today's meetings are still editable)
    function isMeetingPast(startUtcIso) {
        if (!startUtcIso) return false;
        var startDate = new Date(startUtcIso);
        var today = new Date();
        startDate.setHours(0, 0, 0, 0);
        today.setHours(0, 0, 0, 0);
        return startDate < today;
    }

    // Strip HTML tags to show plain text in textarea
    function stripHtml(html) {
        if (!html) return '';
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        return tmp.textContent || tmp.innerText || '';
    }

    function toLocalDatetimeStr(dt) {
        var y = dt.getFullYear();
        var m = ('0' + (dt.getMonth() + 1)).slice(-2);
        var day = ('0' + dt.getDate()).slice(-2);
        var h = ('0' + dt.getHours()).slice(-2);
        var min = ('0' + dt.getMinutes()).slice(-2);
        return y + '-' + m + '-' + day + 'T' + h + ':' + min;
    }

    // Show session detail popup
	function showSessionDetail(sessionId) {
		debugger;
        currentSessionId = sessionId;
        currentSessionData = null;
        $.getJSON('@Url.Action("GetSessionDetails", "TrainingDashboard", new { Area = "TrainingCalendar" })', { sessionId: sessionId }, function (resp) {
			if (resp.success) {
				debugger;
				var d = resp.data;
				currentSessionData = d;
				$('#sdTitle').html('<i class="fas fa-info-circle mr-2"></i>' + escapeHtml(d.Title));

				if (userRole === 'Admin') {
					if (d.Status == "Completed" || d.Status == "Cancelled") {
						$("#CancelBtnID").hide();
					}
					else $("#CancelBtnID").show();
					// Populate editable form
					$('#sdSessionId').val(sessionId);
					$('#sdEditTitle').val(d.Title || '');
					$('#sdEditOrgEmail').val('@(Session["Username"])');  // auto-fill from SSO
					$('#sdEditStatus').val(d.Status || '');
					$('#sdEditAgenda').val(stripHtml(d.Agenda || ''));
					$('#sdEditCount').val((d.RegisteredCount || 0) + ' participants');
					$('#sdEditMaxPart').val(d.MaxParticipants || 100);
					$('#sdEditAttendees').val(d.AttendeeEmails || '');
					$('#sdEditError').addClass('d-none');
					$('#sdEditSuccess').addClass('d-none');

					// Bind dates using ISO string from server
					if (d.StartUtcIso) {
						$('#sdEditStart').val(d.StartUtcIso);
					}
					if (d.EndUtcIso) {
						$('#sdEditEnd').val(d.EndUtcIso);
					}

					// Determine if locked: past meetings OR within 15 min of start
					var past = isMeetingPast(d.StartUtcIso);
					var locked = past || isMeetingLocked(d.StartUtcIso);

					var editableFields = '#sdEditTitle, #sdEditStart, #sdEditEnd, #sdEditAgenda, #sdEditMaxPart, #sdEditAttendees,#sdEditOrgEmail,#sdEditStatus,#sdEditCount';
					if (locked) {
						$(editableFields).prop('readonly', true).prop('disabled', true).addClass("disable-fields");
						if (past) {
							$('#sdLockedBanner').html('<i class="fas fa-lock mr-1"></i> This is a past meeting. Editing is not allowed.').removeClass('d-none');
						} else {
							$('#sdLockedBanner').html('<i class="fas fa-lock mr-1"></i> This meeting starts within 15 minutes or has already started. Editing is locked.').removeClass('d-none');
						}
						$('#sdEditSaveBtn,#CancelBtnID').prop('disabled', true).addClass('d-none');

					} else {
						$(editableFields).prop('readonly', false).prop('disabled', false).removeClass("disable-fields");
						$('#sdLockedBanner').addClass('d-none');
						$('#sdEditSaveBtn,#CancelBtnID').prop('disabled', false).removeClass('d-none');
					}

					// Teams join link — only show for upcoming/active meetings
					if (d.JoinWebUrl && !past) {
						$('#sdJoinLink').attr('href', d.JoinWebUrl);
						$('#sdJoinDiv').removeClass('d-none');
					} else {
						$('#sdJoinDiv').addClass('d-none');
					}

				}
				else if (userRole === 'Dealer') {
					// Populate read-only fields
					$("#CancelBtnID").hide();
					$('#regSubmitBtn').show();
					$('#sdOrganizer').text(d.OrganizerEmail || 'N/A');
					$('#sdDate').text(formatDateRange(d.StartLocal, d.EndLocal));
					$('#sdStatus').text(d.Status);
					$('#sdCount').text(d.RegisteredCount || 0);
					$('#sdAgenda').html(d.Agenda || '<em>No agenda provided</em>');
					debugger;
					$('#regSecEmail').val(resp.managerEmail);


					// Teams join link for dealer
					if (d.JoinWebUrl) {
						$('#sdJoinLinkDealer').attr('href', d.JoinWebUrl);
						$('#sdJoinDivDealer').removeClass('d-none');
					} else {
						$('#sdJoinDivDealer').addClass('d-none');
					}


					// Registration section
					if (resp.isRegistered) {
						$('#sdRegisterSection').addClass('d-none');
						$('#sdAlreadyRegistered').removeClass('d-none');
					} else {

						$('#sdRegisterSection').removeClass('d-none');
						$('#sdAlreadyRegistered').addClass('d-none');
						$('#regSessionId').val(sessionId);
						if (resp.dealerEmail) $('#regEmail').val(resp.dealerEmail);
						if (resp.dealerCode) $('#regDealerCode').val(resp.dealerCode);
						if (d.DisplayName != null && d.DisplayName != "") {
							$('#DisplayNameID').val(d.DisplayName).prop("readonly", true);
							$('#regSubmitBtn').hide();
						}
						$('#regError').addClass('d-none');
						$('#regSuccess').addClass('d-none');
						$('#regSubmitBtn').prop('disabled', false);
					}
				}

				$('#sessionDetailModal').modal('show');
			}
			else {
				swal(resp.message);
				return;
			}
        });
    }

    function formatDateRange(startLocal, endLocal) {
        if (!startLocal || !endLocal) {
            return (startLocal || '') + (endLocal ? (' - ' + endLocal) : '');
        }
        var startParts = startLocal.split(',');
        var endParts = endLocal.split(',');
        if (startParts.length >= 2 && endParts.length >= 2) {
            var startDate = startParts[0].trim();
            var startTime = startParts.slice(1).join(',').trim();
            var endDate = endParts[0].trim();
            var endTime = endParts.slice(1).join(',').trim();
            if (startDate === endDate) {
                return startDate + ', ' + startTime + ' - ' + endTime;
            }
        }
        return startLocal + ' - ' + endLocal;
    }

