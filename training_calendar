@model Mdarpan.Models.BAL.CalendarMonthViewModel

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewBag.Title = string.Format("Training Calendar - {0:MMMM yyyy}", new DateTime(Model.Year, Model.Month, 1));
	ViewBag.ActiveTab = "Calendar";
	var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
	var prevMonth = Model.Month > 1 ? Model.Month - 1 : 12;
	var prevYear = Model.Month > 1 ? Model.Year : Model.Year - 1;
	var nextMonth = Model.Month < 12 ? Model.Month + 1 : 1;
	var nextYear = Model.Month < 12 ? Model.Year : Model.Year + 1;
	string[] dayNames = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
	// Use TodayDate from model (set using IST timezone in controller)
	var todayMonth = Model.TodayDate.Month;
	var todayYear = Model.TodayDate.Year;

}
<link href="~/Content/TrainingCalendar/site.css" rel="stylesheet" />
<style>
	.form-control {
		background: inherit !important;
	}
	.disable-fields
	{
		cursor: not-allowed;
		background-color: #f5f5f5 !important;
	}
	#newMeetingForm .form-control,
	input[type="text"],
	input[type="datetime-local"],
	textarea {
		color: #212529 !important; /* solid dark text */
		opacity: 1 !important;

	}

		#newMeetingForm .form-control:not(:focus)
		 {
			color: #212529 !important; /* override the fade rule */
			opacity: 1 !important;
			background-color: #fff !important;
		}
	.mini-toast {
		position: fixed;
		bottom: 30px;
		left: 50%;
		transform: translateX(-50%);
		background: #323232;
		color: #fff;
		padding: 8px 16px;
		border-radius: 4px;
		font-size: 13px;
		z-index: 99999;
		box-shadow: 0 2px 8px rgba(0,0,0,.2);
	}
	
</style>
<!-- Page Header -->
<div class="page-header">
	<h2><i class="fas fa-calendar-alt mr-2"></i>TRAINING CALENDAR</h2>
	<span style="font-size:0.85rem;opacity:0.8;">@monthName</span>
</div>

<!-- Calendar Card -->
<div class="calendar-card">
	<!-- Gradient Header with Month Navigation -->
	<div class="calendar-header-bar">
		<h2>@monthName</h2>
		<div class="d-flex align-items-center" style="gap:8px;">
			<a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = prevMonth, year = prevYear })" class="calendar-nav-btn">
				<i class="fas fa-chevron-left"></i>
			</a>
			<a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = todayMonth, year = todayYear })" class="calendar-nav-today">
				Today
			</a>
			<a href="@Url.Action("Index", "TrainingDashboard", new {Area="TrainingCalendar", month = nextMonth, year = nextYear })" class="calendar-nav-btn">
				<i class="fas fa-chevron-right"></i>
			</a>
		</div>
	</div>

	<!-- Day Headers -->
	<div class="cal-day-header">
		@foreach (var d in dayNames)
		{
			<span>@d</span>
		}
	</div>

	<!-- Calendar Grid -->
	<div class="cal-grid">
		@foreach (var day in Model.Days)
		{
			var hasSession = day.Sessions.Count > 0;
			var isPast = day.FullDate.Date < Model.TodayDate.Date;
			var cellClass = "cal-cell";
			if (!day.IsCurrentMonth) { cellClass += " other-month"; }
			if (day.FullDate.Date == Model.TodayDate.Date) { cellClass += " today"; }
			if (hasSession) { cellClass += " has-sessions"; }
			if (isPast) { cellClass += " past-day"; }

			<div class="@cellClass" data-date="@day.FullDate.ToString("yyyy-MM-dd")"
				 @if (Session["Role"] as string == "Admin") { if (isPast) { <text> onclick="showPastDateAlert()" </text>  } else { <text> onclick="openNewMeeting('@day.FullDate.ToString("yyyy-MM-dd")')"
				 </text> } }>
				<div class="cal-date">@day.Day</div>
				@foreach (var s in day.Sessions.Take(2))
				{
					var badge = "type-default";
					var title = s.Title ?? "";
					if (title.IndexOf("Stand", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-standup"; }
					else if (title.IndexOf("Focus", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-focus"; }
					else if (title.IndexOf("Team", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "type-team"; }

					<span class="cal-session @badge" title="@s.Title&#10;@s.StartLocal - @s.EndLocal"
						  onclick="event.stopPropagation(); showSessionDetail(@s.SessionId);">
						@s.Title
					</span>
				}
				@if (day.Sessions.Count > 2)
				{
					var daySessJson = Newtonsoft.Json.JsonConvert.SerializeObject(
						day.Sessions.Select(s => new { s.SessionId, s.Title, Start = s.StartLocal ?? "", End = s.EndLocal ?? "" }));
					<span class="cal-more" onclick="event.stopPropagation(); showDaySessions(this)"
						  data-date="@day.FullDate.ToString("yyyy-MM-dd")"
						  data-sessions='@Html.Raw(daySessJson)'>+@(day.Sessions.Count - 2) more</span>
				}
			</div>
		}
	</div>

	<!-- Footer with Legend -->
	<div class="calendar-footer">
		<div>
			<span class="legend-item"><span class="legend-dot blue"></span>Team</span>
			<span class="legend-item"><span class="legend-dot yellow"></span>Focus</span>
			<span class="legend-item"><span class="legend-dot green"></span>Stand-up</span>
		</div>
		<span class="meeting-count">@Model.Sessions.Count meetings</span>
	</div>
</div>

<!-- Past-date alert toast -->
<div id="pastDateToast" style="display:none; position:fixed; top:80px; left:50%; transform:translateX(-50%); z-index:9999; min-width:320px;">
	<div class="alert alert-warning alert-dismissible shadow" role="alert" style="border-left:4px solid #f59e0b;">
		<i class="fas fa-exclamation-triangle mr-2"></i>
		<strong>Past Date Selected!</strong> You cannot schedule a meeting on a past date. Please select today or a future date.
		<button type="button" class="close" onclick="$(this).closest('#pastDateToast').fadeOut()">
			<span>&times;</span>
		</button>
	</div>
</div>

<!-- New Meeting Modal -->
<div class="modal fade" id="newMeetingModal" tabindex="-1" role="dialog">
	<div class="modal-dialog modal-lg" role="document">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fas fa-calendar-plus mr-2"></i>Schedule New Meeting</h5>
				<button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
			</div>
			@Html.Partial("_NewMeetingForm")
		</div>
	</div>
</div>

